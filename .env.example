# === MEGABRAIN JEV DESK CONFIGURATION ===
# Copy this to .env and fill in your values

# TypeSafe API Key (from console.typesafe.ai)
TYPESAFE_API_KEY=ts-your-key-here

# Desk secret for bot authentication (NOT the TypeSafe key)
DESK_SECRET=your-desk-secret-here

# Judge URL (public endpoint bots call)
JUDGE_URL=https://your-desk.example.com/judge

# Your bank size in USD (for sizing calculations)
BANK_USD=1000

# FOMO API credentials (from Chrome session)
# These are managed by fomo_api library, no direct config needed