# === MEGABRAIN LOCAL TRADING DESK ===
# No paid APIs required! Uses free alternatives.

# Optional: Laya model (run locally with Ollama)
# Install: https://ollama.com
# Then: ollama pull laya
# Set OLLAMA_HOST=http://localhost:11434

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=laya

# Desk settings
BANK_USD=1000
SHADOW_MODE=true  # Set to false to enable real trading (use caution!)
CYCLE_MINUTES=15

# Networks to scan (comma-separated)
NETWORKS=solana,bsc

# Risk settings
MAX_TICKET_USD=60
STOP_LOSS_PCT=0.10
TAKE_PROFIT_PCT=0.25